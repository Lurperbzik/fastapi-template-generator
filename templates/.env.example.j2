# Variables de entorno para {{ model.name }} v{{ model.version }}
# Copia este fichero a .env y rellena los valores

# ── Base de datos (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://admin:secret@db:5432/{{ model.name | lower }}
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret

# ── Aplicación ─────────────────────────────────────────────────
SECRET_KEY=cambiame_por_un_valor_seguro
DEBUG=true